# PRAMAAN backend configuration -- copy to .env and edit as needed.
#
#   cp .env.example .env
#
# Every variable is optional; the defaults below are the development defaults
# baked into backend/app/config.py. All keys use the PRAMAAN_ prefix.
# Never commit a real .env -- it is git-ignored.

# --- Environment ---
# development | testing | production
PRAMAAN_ENVIRONMENT=development
PRAMAAN_DEBUG=true

# --- Server ---
PRAMAAN_HOST=127.0.0.1
PRAMAAN_PORT=8000

# --- Logging ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG
PRAMAAN_LOG_LEVEL=INFO
# Per-request access log line (method, path, status, duration, request id)
PRAMAAN_LOG_ACCESS=true

# --- Paths ---
# Absolute, or relative to the project root. Directories are created on start.
PRAMAAN_DATA_DIR=backend/data
PRAMAAN_REPORTS_DIR=backend/reports
PRAMAAN_CORPUS_DIR=corpus

# --- Ingestion ---
# 64 MiB. Larger uploads are rejected with 413, never truncated.
PRAMAAN_MAX_UPLOAD_BYTES=67108864
# The media type is decided by sniffing the file's own bytes; these lists only
# say which extensions are accepted at all.
PRAMAAN_ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,tif,tiff,bmp,gif
PRAMAAN_ALLOWED_VIDEO_EXTENSIONS=mp4,mov,m4v,avi,mkv,webm
PRAMAAN_ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,aac,flac,ogg

# --- Perceptual hashing and near-duplicate retrieval ---
# Hamming-distance cut-offs over 64-bit hashes. A hit inside these bands is a
# CANDIDATE FOR COMPARISON, not proof that two files are the same image.
PRAMAAN_HASH_BITS=64
PRAMAAN_RETRIEVAL_TOP_K=25
PRAMAAN_NEAR_DUPLICATE_MAX_DISTANCE=12
PRAMAAN_STRONG_DUPLICATE_MAX_DISTANCE=6

# --- Fusion weights (PROTOTYPE DEFAULTS -- not validated) ---
# Transparent weighted mean over the five signals. Renormalised over whatever
# weight was actually available, so an unavailable signal is EXCLUDED rather
# than scored zero. These numbers have no known error rate against a forensic
# reference dataset; they are configurable for exactly that reason.
PRAMAAN_FUSION_WEIGHT_AI_DETECTION=0.35
PRAMAAN_FUSION_WEIGHT_PERCEPTUAL=0.20
PRAMAAN_FUSION_WEIGHT_METADATA=0.20
PRAMAAN_FUSION_WEIGHT_PROVENANCE=0.15
PRAMAAN_FUSION_WEIGHT_FORENSICS=0.10

# --- Verdict thresholds (PROTOTYPE DEFAULTS -- not validated) ---
# Below fusion_min_effective_weight of the declared weight, the verdict is
# INSUFFICIENT_EVIDENCE: a statement about the analysis, not about the media.
PRAMAAN_VERDICT_MANIPULATED_THRESHOLD=0.65
PRAMAAN_VERDICT_AUTHENTIC_THRESHOLD=0.35
PRAMAAN_FUSION_MIN_EFFECTIVE_WEIGHT=0.30

# --- AI detector: the plug-in sockets ---
# Nothing below is required. With every socket empty, the ai_detection signal is
# reported as UNAVAILABLE and excluded from fusion -- no score is invented, and
# no other stage is affected. See docs/DETECTOR_PLUGIN.md.
#
# auto: use a local detector if one is installed, else report UNAVAILABLE.
# null: always report UNAVAILABLE (useful for a control run).
PRAMAAN_DETECTOR_BACKEND=auto
#
# Socket 1 -- model files. A plain ONNX or TorchScript image classifier needs
# only this. Fallback for image when *_IMAGE_MODEL_PATH is unset:
PRAMAAN_DETECTOR_MODEL_PATH=
PRAMAAN_IMAGE_MODEL_PATH=pramaan-detector/weights/image_detector.pt
PRAMAAN_VIDEO_MODEL_PATH=pramaan-detector/weights/image_detector.pt
PRAMAAN_AUDIO_MODEL_PATH=pramaan-detector/weights/audio_detector.pt
#
# Socket 2 -- inference code, as "module:callable"
PRAMAAN_IMAGE_DETECTOR_ENTRYPOINT=pramaan.detectors.image_detector:detect_image
PRAMAAN_VIDEO_DETECTOR_ENTRYPOINT=pramaan.detectors.video_detector:detect_video
PRAMAAN_AUDIO_DETECTOR_ENTRYPOINT=pramaan.detectors.audio_detector:detect_audio

# --- Reporting ---
# Printed on the sign-off block when the request does not name an examiner.
PRAMAAN_REPORT_EXAMINER=
PRAMAAN_REPORT_ORGANISATION=PRAMAAN Prototype Deployment

# --- CORS (comma-separated, not JSON) ---
# Local React dev servers: Vite on 5173, CRA / Next.js on 3000.
PRAMAAN_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
PRAMAAN_CORS_ALLOW_METHODS=*
PRAMAAN_CORS_ALLOW_HEADERS=*
PRAMAAN_CORS_ALLOW_CREDENTIALS=false
