# PRAMAAN backend configuration -- copy to .env and edit as needed.
#
#   cp .env.example .env
#
# Every variable is optional; the defaults below are the development defaults
# baked into backend/app/config.py. All keys use the PRAMAAN_ prefix.
# Never commit a real .env -- it is git-ignored.

# --- Environment ---
# development | testing | production
PRAMAAN_ENVIRONMENT=development
PRAMAAN_DEBUG=true

# --- Server ---
PRAMAAN_HOST=127.0.0.1
PRAMAAN_PORT=8000

# --- Logging ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG
PRAMAAN_LOG_LEVEL=INFO
# Per-request access log line (method, path, status, duration, request id)
PRAMAAN_LOG_ACCESS=true

# --- Paths ---
# Absolute, or relative to the project root. Directories are created on start.
PRAMAAN_DATA_DIR=backend/data
PRAMAAN_REPORTS_DIR=backend/reports
PRAMAAN_CORPUS_DIR=corpus

# --- Ingestion ---
# 64 MiB. Larger uploads are rejected with 413, never truncated.
PRAMAAN_MAX_UPLOAD_BYTES=67108864
# The media type is decided by sniffing the file's own bytes; these lists only
# say which extensions are accepted at all.
PRAMAAN_ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,tif,tiff,bmp,gif
PRAMAAN_ALLOWED_VIDEO_EXTENSIONS=mp4,mov,m4v,avi,mkv,webm
PRAMAAN_ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,aac,flac,ogg

# --- Perceptual hashing and near-duplicate retrieval ---
# Hamming-distance cut-offs over 64-bit hashes. A hit inside these bands is a
# CANDIDATE FOR COMPARISON, not proof that two files are the same image.
PRAMAAN_HASH_BITS=64
PRAMAAN_RETRIEVAL_TOP_K=25
PRAMAAN_NEAR_DUPLICATE_MAX_DISTANCE=12
PRAMAAN_STRONG_DUPLICATE_MAX_DISTANCE=6

# --- Fusion weights (PROTOTYPE DEFAULTS -- not validated) ---
# Transparent weighted mean over the five signals. Renormalised over whatever
# weight was actually available, so an unavailable signal is EXCLUDED rather
# than scored zero. These numbers have no known error rate against a forensic
# reference dataset; they are configurable for exactly that reason.
PRAMAAN_FUSION_WEIGHT_AI_DETECTION=0.35
PRAMAAN_FUSION_WEIGHT_PERCEPTUAL=0.20
PRAMAAN_FUSION_WEIGHT_METADATA=0.20
PRAMAAN_FUSION_WEIGHT_PROVENANCE=0.15
PRAMAAN_FUSION_WEIGHT_FORENSICS=0.10

# --- Verdict thresholds (PROTOTYPE DEFAULTS -- not validated) ---
# Below fusion_min_effective_weight of the declared weight, the verdict is
# INSUFFICIENT_EVIDENCE: a statement about the analysis, not about the media.
PRAMAAN_VERDICT_MANIPULATED_THRESHOLD=0.65
PRAMAAN_VERDICT_AUTHENTIC_THRESHOLD=0.35
PRAMAAN_FUSION_MIN_EFFECTIVE_WEIGHT=0.30

# --- AI detector: the plug-in sockets ---
# Nothing below is required. With every socket empty, the ai_detection signal is
# reported as UNAVAILABLE and excluded from fusion -- no score is invented, and
# no other stage is affected. See docs/DETECTOR_PLUGIN.md.
#
# auto: use a local detector if one is installed, else report UNAVAILABLE.
# null: always report UNAVAILABLE (useful for a control run).
PRAMAAN_DETECTOR_BACKEND=auto
#
# Socket 1 -- model files. A plain ONNX or TorchScript image classifier needs
# only this. Fallback for image when *_IMAGE_MODEL_PATH is unset:
PRAMAAN_DETECTOR_MODEL_PATH=
PRAMAAN_IMAGE_MODEL_PATH=pramaan-detector/weights/image_detector.pt
# No video checkpoint is published (see the manifest's "video" entry), so this is
# deliberately empty. Do NOT point it at image_detector.pt or audio_detector.pt:
# those hold Swin-B and wav2vec2 parameters, neither of which fits the
# EfficientNet-B0 frame model, so doing so installs no video detector -- it only
# makes the status endpoint name a model that never scored a frame. With this
# empty, video reports INSUFFICIENT_EVIDENCE and says why.
PRAMAAN_VIDEO_MODEL_PATH=
# Loading this model peaks at ~1.67 GB RSS (measured). Leave it empty on any
# instance smaller than 2 GB; audio then reports INSUFFICIENT_EVIDENCE instead of
# being OOM-killed mid-request.
PRAMAAN_AUDIO_MODEL_PATH=pramaan-detector/weights/audio_detector.pt
#
# Socket 2 -- inference code, as "module:callable"
PRAMAAN_IMAGE_DETECTOR_ENTRYPOINT=pramaan.detectors.image_detector:detect_image
# The video module is genuinely installed, so it stays configured: with no
# checkpoint it reports a named, explained unavailability rather than an
# unconfigured socket. It never fabricates a score.
PRAMAAN_VIDEO_DETECTOR_ENTRYPOINT=pramaan.detectors.video_detector:detect_video
PRAMAAN_AUDIO_DETECTOR_ENTRYPOINT=pramaan.detectors.audio_detector:detect_audio
#
# Socket 3 -- the memory-mapped safetensors directory the image loader prefers.
# Produced by `python scripts/convert_detector_weights.py`. Ignored if absent, or
# if its source.json says it came from a different checkpoint.
PRAMAAN_IMAGE_MODEL_HF_DIR=pramaan-detector/weights/image_detector_hf
#
# Socket 4 -- refuse to reach a model hub at inference time. The checkpoint is
# loaded from disk and verified against the manifest; a silent hub download would
# substitute an unpinned revision for the weights a report names. Setting this
# exports HF_HUB_OFFLINE / TRANSFORMERS_OFFLINE into the process environment,
# which is where transformers actually looks (a bare .env entry would not work).
PRAMAAN_DETECTOR_OFFLINE=true

# --- AI detector: runtime behaviour (all optional; values below are defaults) ---
# Load the model during startup instead of on the first analysis. Off by default:
# pulling 347 MB of weights in before the first health check answers is how a slow
# start becomes a failed deploy. Turn it on to pay that cost once, up front.
PRAMAAN_DETECTOR_PREWARM=false
# How many analyses may run at once. One Swin-B forward pass costs ~26 MB of
# activations and a Grad-CAM pass ~206 MB on top of 347 MB of resident weights, so
# concurrent analyses add their peaks together. Raise only with measured headroom.
PRAMAAN_DETECTOR_MAX_CONCURRENCY=1
# Seconds a request waits for the inference slot before abstaining. Bounded so a
# backlog reports UNAVAILABLE instead of holding the worker past the proxy's own
# timeout and turning into a 502.
PRAMAAN_DETECTOR_QUEUE_TIMEOUT_S=120
#
# Run no model in this process: forward the file to a separate detector service
# and return what it measured. Same adapter contract, same abstention semantics.
# Empty (the default) means inference happens in-process.
PRAMAAN_DETECTOR_REMOTE_URL=
# Shared bearer token for that service. Held as a SecretStr, so it cannot be
# printed by an accidental repr of the settings object.
PRAMAAN_DETECTOR_REMOTE_TOKEN=
#
# The two below are read directly from the process environment by the detector
# package, NOT through this file's settings object -- so unlike everything else
# here, a bare .env entry does not reach them. Export them in the shell, the
# Dockerfile, or the platform's env config.
#
# 0 disables Grad-CAM. The manipulation score is unaffected; the heatmap costs
# ~206 MB of peak RSS, and heatmap_available is then reported false rather than an
# empty heatmap being presented as a real one.
PRAMAAN_DETECTOR_HEATMAP=1
# Torch CPU threads. Left at torch's default (one per core) a single forward pass
# saturates every core it can see, starving the event loop that answers /health.
PRAMAAN_TORCH_THREADS=1

# --- Model asset provisioning (build time, not runtime) ---
# Checkpoints are not in Git. `python scripts/download_weights.py` fetches them
# from a GitHub Release and rejects any file whose SHA-256 does not match
# pramaan-detector/weights/model_manifest.json, which is the single source of
# truth for filenames, sizes and digests.
#
#   python scripts/download_weights.py --all --strict   # fetch + verify everything
#   python scripts/verify_model_assets.py               # verify + actually load
#
# Where the checkpoints land. Relative paths resolve against the repo root.
PRAMAAN_WEIGHTS_DIR=pramaan-detector/weights
# Which checkpoints to fetch (csv of image,video,audio). "video" has no published
# asset, so listing it fetches nothing and is reported as such. Default when
# unset: image only. Omit "audio" on an instance under 2 GB -- it is a 1.26 GB
# download for a model that cannot be held there.
PRAMAAN_WEIGHTS_MODALITIES=image,audio
# Which release the assets come from. Defaults live in the manifest's "release".
PRAMAAN_WEIGHTS_RELEASE_REPO=
PRAMAAN_WEIGHTS_RELEASE_TAG=
# Per-asset overrides -- a mirror, a signed URL, or a local file:// path. These
# take precedence over the release asset URL.
PRAMAAN_IMAGE_WEIGHTS_URL=
# There is no published video asset for this to override. It exists only so a
# deployment that has trained its own video_detector.pt can point at it -- after
# adding that file's size and SHA-256 to the manifest.
PRAMAAN_VIDEO_WEIGHTS_URL=
PRAMAAN_AUDIO_WEIGHTS_URL=
# 1 = a missing asset is a build failure. 0 = it degrades to UNAVAILABLE.
PRAMAAN_FAIL_ON_MISSING_WEIGHTS=0
# 1 = accept a checkpoint whose digest does not match the manifest. Only for
# local experiments with a checkpoint you built yourself: a silently truncated
# or wrong-revision model produces confident, wrong forensic verdicts.
PRAMAAN_ALLOW_UNVERIFIED_WEIGHTS=0

# --- Reporting ---
# Printed on the sign-off block when the request does not name an examiner.
PRAMAAN_REPORT_EXAMINER=
PRAMAAN_REPORT_ORGANISATION=PRAMAAN Prototype Deployment

# --- CORS (comma-separated, not JSON) ---
# Local React dev servers: Vite on 5173, CRA / Next.js on 3000.
PRAMAAN_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
PRAMAAN_CORS_ALLOW_METHODS=*
PRAMAAN_CORS_ALLOW_HEADERS=*
PRAMAAN_CORS_ALLOW_CREDENTIALS=false
