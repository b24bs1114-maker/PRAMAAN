# PRAMAAN frontend configuration -- copy to .env.development (or .env.local)
#
#   cp .env.example .env.development
#
# Only VITE_-prefixed variables are exposed to the browser by Vite.

# --- Backend base URL ---------------------------------------------------------
# The single place the backend origin is configured. No component hardcodes it.
# If this is unset, src/api/config.ts falls back to http://127.0.0.1:8000 so a
# fresh clone runs with no .env file at all.
#
# Local development:
VITE_API_URL=http://127.0.0.1:8000
#
# Production -- set this in the deployment environment, never in committed code:
# VITE_API_URL=https://pramaan-api.example.gov.in
#
# The backend must list the frontend's own origin in PRAMAAN_CORS_ALLOW_ORIGINS
# (see ../.env.example) or the browser will block the response.
