{
  "name": "pramaan-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PRAMAAN investigation console \u2014 frontend for the forensic media provenance API",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "verify:contract": "node tests/run-contract.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0"
  }
}
