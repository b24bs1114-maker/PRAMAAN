# --- Python artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets (never commit) ---
.env
.env.*
!.env.example

# --- Test & tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage*
htmlcov/
coverage.xml

# --- Evidence & case data (never commit) ---
data/evidence/
backend/data/evidence/
backend/data/uploads/
backend/data/tmp/

# --- SQLite databases ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- FAISS / vector indexes ---
*.faiss
*.index
*.ann
backend/data/faiss/
backend/data/index/

# --- Generated forensic reports (regenerated from evidence) ---
/reports/*
!/reports/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# --- Synthetic corpus media (script-generated, regenerable) ---
# Manifests and generator scripts are tracked; binaries are not.
corpus/**/*.png
corpus/**/*.jpg
corpus/**/*.jpeg
corpus/**/*.webp
corpus/**/*.tif
corpus/**/*.tiff
corpus/**/*.mp4
corpus/**/*.mov
!corpus/**/manifest.json
!corpus/**/*.manifest.json

# --- Node / frontend (Rahul) ---
node_modules/
npm-debug.log*
yarn-error.log*
frontend/dist/
frontend/build/
frontend/.next/
frontend/.vite/
# TypeScript incremental build cache (regenerated by `tsc -b`)
*.tsbuildinfo

# --- OS files ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.claude/.cc-writes/

# --- Agent / tooling scaffolding (NOT PRAMAAN source) ---
# These are working copies dropped in by external agent tooling. They are the
# reason the change counter looked huge (~230k LOC in .tmp-ruflo alone) and are
# regenerable — none of it is project code. Un-ignore individually if you ever
# want to track a specific skill.
.tmp-ruflo/
.agents/
.impeccable/

# Local environments / dependencies
.venv/
**/.venv/
node_modules/
**/node_modules/

# Build / cache
dist/
**/dist/
build/
**/build/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/

# Secrets
.env
**/.env

# Local / deployment artifacts
PRAMAAN_DEPLOY/
*.zip

# Large model weights -- provisioned by scripts/download_weights.py from a
# GitHub Release and verified against pramaan-detector/weights/model_manifest.json.
# The manifest and the sidecar *.pt.json specs ARE tracked; the binaries are not.
*.pt
*.pth
*.onnx
*.safetensors
*.tflite
*.pt.part
pramaan-detector/weights/*_hf/
!pramaan-detector/weights/model_manifest.json
!pramaan-detector/weights/*.pt.json

# Local tooling / OS
.claude/
.DS_Store
*.log

# Detector demo/test media
pramaan-detector/data/ai_test_samples/
pramaan-detector/data/midjourney_samples/
pramaan-detector/data/real_samples/
